<section class="border-b border-line bg-white py-14">
  <div class="container-page max-w-4xl">
    <p class="text-sm font-bold uppercase tracking-wider text-flame"><%= tool.category %></p>
    <h1 class="mt-3 font-display text-4xl font-extrabold"><%= tool.name %></h1>
    <p class="mt-4 text-lg leading-8 text-ink/70"><%= tool.description %></p>
  </div>
</section>

<section class="bg-paper py-14">
  <div class="container-page max-w-4xl">
    <div class="rounded-2xl border border-line bg-white p-8 shadow-soft">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-ocean">Tool Details</p>
      <p class="mt-4 text-base leading-8 text-ink/75">This tool is now managed from the admin panel and is included in the sitemap when published.</p>
    </div>
  </div>
</section>
