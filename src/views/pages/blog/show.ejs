<article class="py-14">
  <div class="container-page max-w-4xl">
    <div class="flex items-center justify-between gap-4">
      <a href="/blog" data-back class="focus-ring inline-flex min-h-11 items-center justify-center gap-2.5 rounded-xl border border-white/70 bg-white/60 px-5 py-2.5 text-sm font-semibold text-ink backdrop-blur-md transition-all hover:border-[#7c3aed]/40 hover:text-[#7c3aed] dark:border-white/15 dark:bg-white/[0.06] dark:text-white/80 dark:hover:border-[#a78bfa]/40 dark:hover:text-[#a78bfa]">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
        Go Back
      </a>
    </div>
    <%- include("../../partials/breadcrumbs") %>
    <h1 class="mt-4 font-display text-4xl font-extrabold leading-tight sm:text-5xl"><%= post.title %></h1>
    <p class="mt-5 text-lg leading-8 text-ink/70 dark:text-white/60"><%= post.excerpt %></p>
    <div class="mt-5 flex flex-wrap gap-3 text-sm font-bold text-ink/55 dark:text-white/45">
      <span><%= post.readingTime %> min read</span>
      <% (post.categories || []).forEach((category) => { %><a class="rounded-md bg-[#7c3aed]/10 px-2 py-0.5 text-[#7c3aed] transition-colors hover:bg-[#7c3aed]/20 dark:bg-[#a78bfa]/15 dark:text-[#a78bfa]" href="/blog?category=<%= encodeURIComponent(category) %>"><%= category %></a><% }) %>
      <% (post.tags || []).forEach((tag) => { %><span>#<%= tag %></span><% }) %>
    </div>
    <% if (post.coverImage) { %>
      <img class="mt-8 aspect-[16/9] w-full rounded-2xl border border-white/60 object-cover dark:border-white/10 shadow-xl" src="<%= post.coverImage %>" alt="" fetchpriority="high" decoding="async" referrerpolicy="no-referrer">
    <% } %>
    <div class="prose prose-neutral mt-10 max-w-none prose-headings:font-display">
      <%- post.html %>
    </div>
  </div>
</article>

<% if (relatedPosts.length) { %>
  <section class="py-14">
    <div class="container-page">
      <h2 class="font-display text-3xl font-extrabold">Related posts</h2>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <% relatedPosts.forEach((item) => { %>
          <article class="glass-card p-5">
            <h3 class="font-bold"><a href="/blog/<%= item.slug %>"><%= item.title %></a></h3>
            <p class="mt-2 text-sm leading-6 text-ink/70 dark:text-white/60"><%= item.excerpt %></p>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
<% } %>
