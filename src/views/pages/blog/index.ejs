<section class="py-14">
  <div class="container-page">
    <p class="text-sm font-bold uppercase tracking-wider text-flame">Tech Blog</p>
    <h1 class="mt-3 font-display text-4xl font-extrabold">Engineering notes and case studies</h1>
    <form action="/blog" method="get" class="mt-8 flex max-w-xl gap-2">
      <input class="glass-input min-h-11 min-w-0 flex-1" name="search" value="<%= search %>" placeholder="Search posts">
      <button class="btn-primary" type="submit">Search</button>
    </form>
  </div>
</section>

<section class="py-14">
  <div class="container-page">
    <% if (!posts.length) { %>
      <div class="glass-card p-8 text-center">
        <h2 class="font-display text-2xl font-extrabold">No posts yet</h2>
        <p class="mt-2 text-ink/70 dark:text-white/60">Published writing will appear here.</p>
      </div>
    <% } %>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% posts.forEach((post) => { %>
        <article class="glass-card p-5">
          <% if (post.featured) { %><span class="rounded-md bg-flame/10 px-2 py-1 text-xs font-bold text-flame">Featured</span><% } %>
          <% if (post.coverImage) { %>
            <a href="/blog/<%= post.slug %>">
              <img class="mt-3 aspect-[16/9] w-full rounded-xl object-cover shadow-soft" src="<%= post.coverImage %>" alt="" loading="lazy" decoding="async">
            </a>
          <% } %>
          <h2 class="mt-3 text-xl font-extrabold"><a href="/blog/<%= post.slug %>"><%= post.title %></a></h2>
          <p class="mt-3 text-sm leading-6 text-ink/70 dark:text-white/60"><%= post.excerpt %></p>
          <div class="mt-4 flex flex-wrap gap-2 text-xs font-bold text-ink/55 dark:text-white/45">
            <span><%= post.readingTime %> min read</span>
            <% (post.tags || []).slice(0, 3).forEach((tag) => { %><span>#<%= tag %></span><% }) %>
          </div>
        </article>
      <% }) %>
    </div>
    <% if (totalPages > 1) { %>
      <nav class="mt-10 flex justify-center gap-2" aria-label="Pagination">
        <% for (let i = 1; i <= totalPages; i += 1) { %>
          <a class="rounded-lg border border-white/70 bg-white/60 px-3 py-2 text-sm font-bold backdrop-blur-md dark:border-white/15 dark:bg-white/[0.08] <%= i === page ? 'bg-ink text-white dark:bg-[#a78bfa] dark:text-[#0b0f19]' : 'bg-white text-ink dark:text-white/80' %>" href="/blog?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %>"><%= i %></a>
        <% } %>
      </nav>
    <% } %>
  </div>
</section>
