<section class="py-14">
  <div class="container-page">
    <%- include("../../partials/breadcrumbs") %>
    <p class="mt-4 text-sm font-bold uppercase tracking-wider text-flame">Blog</p>
    <h1 class="mt-3 font-display text-4xl font-extrabold">Categories</h1>
    <p class="mt-3 max-w-2xl text-base leading-8 text-ink/70">Browse all articles by topic.</p>
  </div>
</section>

<section class="py-14">
  <div class="container-page">
    <% if (!categories.length) { %>
      <div class="glass-card p-8 text-center">
        <h2 class="font-display text-2xl font-extrabold">No categories yet</h2>
        <p class="mt-2 text-ink/70">Published writing will appear here.</p>
      </div>
    <% } %>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% categories.forEach((category) => { %>
        <a class="glass-card glass-card-hover block p-6" href="/blog/category/<%= category.slug %>">
          <h2 class="font-display text-xl font-extrabold"><%= category.name %></h2>
          <p class="mt-2 text-sm text-ink/70"><%= category.count %> <%= category.count === 1 ? "article" : "articles" %></p>
        </a>
      <% }) %>
    </div>
  </div>
</section>
