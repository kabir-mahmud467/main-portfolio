<section class="py-14">
  <div class="container-page">
    <%- include("../../partials/breadcrumbs") %>
    <p class="mt-4 text-sm font-bold uppercase tracking-wider text-flame">Category</p>
    <h1 class="mt-3 font-display text-4xl font-extrabold"><%= category.name %></h1>
    <p class="mt-3 max-w-2xl text-base leading-8 text-ink/70">
      <%= category.count %> <%= category.count === 1 ? "article" : "articles" %> about <%= category.name.toLowerCase() %> — guides, tutorials, and engineering notes.
    </p>
  </div>
</section>

<section class="py-14">
  <div class="container-page">
    <% if (!posts.length) { %>
      <div class="glass-card p-8 text-center">
        <h2 class="font-display text-2xl font-extrabold">No posts in this category yet</h2>
        <p class="mt-2 text-ink/70">New writing will appear here.</p>
      </div>
    <% } %>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      <% posts.forEach((post) => { %>
        <article class="glass-card p-5">
          <% if (post.featured) { %><span class="rounded-md bg-flame/10 px-2 py-1 text-xs font-bold text-flame">Featured</span><% } %>
          <h2 class="mt-3 text-xl font-extrabold"><a href="/blog/<%= post.slug %>"><%= post.title %></a></h2>
          <p class="mt-3 text-sm leading-6 text-ink/70"><%= post.excerpt %></p>
          <div class="mt-4 flex flex-wrap gap-2 text-xs font-bold text-ink/55">
            <span><%= post.readingTime %> min read</span>
            <% (post.tags || []).slice(0, 3).forEach((tag) => { %><span>#<%= tag %></span><% }) %>
          </div>
        </article>
      <% }) %>
    </div>
    <% if (totalPages > 1) { %>
      <nav class="mt-10 flex justify-center gap-2" aria-label="Pagination">
        <% for (let i = 1; i <= totalPages; i += 1) { %>
          <a class="rounded-lg border border-white/70 bg-white/60 px-3 py-2 text-sm font-bold backdrop-blur-md <%= i === page ? 'bg-ink text-white' : 'bg-white text-ink' %>" href="/blog/category/<%= category.slug %>?page=<%= i %>"><%= i %></a>
        <% } %>
      </nav>
    <% } %>
  </div>
</section>
