  <div class="container-page">
    <div class="glass-panel mx-auto max-w-3xl bg-gradient-to-br from-[#1e293b]/90 to-[#0f172a]/90 p-10 text-center shadow-2xl sm:p-14">
      <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden rounded-3xl" aria-hidden="true">
        <div class="animate-float absolute -top-16 -right-16 h-48 w-48 rounded-full bg-[#7c3aed]/30 blur-3xl"></div>
