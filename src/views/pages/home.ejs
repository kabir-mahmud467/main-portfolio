<!-- Hero Section -->
<section class="relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="animate-float absolute -top-40 -right-40 h-80 w-80 rounded-full bg-[#7c3aed]/20 blur-3xl"></div>
    <div class="animate-float-delayed absolute -bottom-40 -left-40 h-80 w-80 rounded-full bg-[#6366f1]/20 blur-3xl"></div>
    <div class="animate-float absolute top-1/3 left-1/4 h-4 w-4 rounded-full bg-[#7c3aed]/30"></div>
    <div class="animate-float-delayed absolute top-1/4 right-1/3 h-6 w-6 rounded-full bg-[#6366f1]/25"></div>
    <div class="animate-float absolute bottom-1/3 right-1/4 h-3 w-3 rounded-full bg-[#8b5cf6]/30"></div>
  </div>
  <div class="container-page relative z-10">
    <div class="mx-auto max-w-4xl text-center">
      <div class="glass-chip animate-fade-up mx-auto text-base font-bold text-[#7c3aed] sm:text-lg">
        <span class="h-2 w-2 rounded-full bg-gradient-to-r from-[#7c3aed] to-[#6366f1]"></span>
        Kabir Mahmud
      </div>
      <h1 class="animate-fade-up mt-6 font-display text-5xl font-extrabold leading-tight sm:text-6xl lg:text-7xl" style="animation-delay: 100ms">
        <span class="animate-gradient bg-gradient-to-r from-[#7c3aed] via-[#6366f1] to-[#ec4899] bg-clip-text text-transparent">Software architecture</span>
        <br>
        <span class="text-[#1a1a2e] dark:text-white">developer tools, and</span>
        <br>
        <span class="text-[#1a1a2e] dark:text-white">technical content that scale.</span>
      </h1>
      <p class="animate-fade-up mx-auto mt-6 max-w-2xl text-lg leading-8 text-[#64748b] dark:text-[#a0a8bd]" style="animation-delay: 200ms">
        A premium personal platform for full-stack engineering, portfolio proof, practical writing, and fast browser-first utilities.
      </p>
      <div class="animate-fade-up mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row" style="animation-delay: 300ms">
        <a href="/projects" class="btn-primary text-base">
          <svg class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" /></svg>
          View Projects
        </a>
        <a href="https://tools.kabirmahmud.xyz" target="_blank" rel="noopener noreferrer" class="btn-secondary text-base">
          <svg class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
          Explore Tools
        </a>
      </div>
    </div>

    <div class="animate-scale-in glass-panel mx-auto mt-16 max-w-2xl p-6" style="animation-delay: 400ms">
      <div class="mb-4 flex gap-2">
        <span class="h-3 w-3 rounded-full bg-[#ef4444]"></span>
        <span class="h-3 w-3 rounded-full bg-[#eab308]"></span>
        <span class="h-3 w-3 rounded-full bg-[#22c55e]"></span>
      </div>
      <pre class="overflow-x-auto"><code class="block whitespace-pre text-sm leading-7 text-[#1e293b] dark:text-[#c9d1e8]">const engineer = {
  stack: ["React", "Vite", "Node.js", "Express", "MongoDB"],
  environments: ["Linux/Kali/Debian", "Vercel"],
  focus: "Full-Stack Applications & Interactive UI",
  modules: ["3D Graphics", "Branching Engines", "SEO Utilities"],
  posture: "Secure, performant, clean architecture"
};</code></pre>
    </div>
  </div>
</section>

<!-- About Section -->
<section class="py-20">
  <div class="container-page">
    <div class="glass-panel mx-auto max-w-5xl p-8 sm:p-12">
      <div class="grid items-center gap-12 lg:grid-cols-[0.7fr_1.3fr]">
        <div class="flex justify-center">
          <div class="animate-fade-up group relative">
            <div class="h-36 w-36 rounded-full bg-gradient-to-br from-[#7c3aed] to-[#6366f1] p-1 shadow-[0_12px_40px_rgba(124,58,237,0.35)] ring-4 ring-[#7c3aed]/15 transition-transform duration-300 group-hover:scale-105">
              <div class="h-full w-full overflow-hidden rounded-full bg-white">
                <img src="/images/avatar-320.jpg" alt="Kabir Mahmud" class="h-full w-full object-cover" loading="eager"
                  onerror="this.parentElement.innerHTML='<span class=\'flex h-full w-full items-center justify-center text-5xl font-bold text-[#7c3aed]\'>KM</span>'">
              </div>
            </div>
            <div class="glass-chip absolute -bottom-2 -right-2 h-12 w-12 rounded-full !p-0">
              <span class="flex h-full w-full items-center justify-center rounded-full bg-gradient-to-br from-[#7c3aed] to-[#6366f1] text-base font-bold text-white shadow-lg">5+</span>
            </div>
          </div>
        </div>
        <div class="animate-fade-up" style="animation-delay: 100ms">
          <p class="text-sm font-bold uppercase tracking-widest text-[#7c3aed] dark:text-[#a78bfa]">About</p>
          <h2 class="mt-3 font-display text-3xl font-extrabold text-[#1a1a2e] dark:text-white sm:text-4xl">A developer brand built around useful systems.</h2>
          <p class="mt-6 text-lg leading-8 text-[#64748b] dark:text-[#a0a8bd]">
            Kabir Mahmud focuses on production-ready web platforms: clean client-side React architectures, practical back-end workflows, structural digital publishing, SEO strategy, and interactive interfaces enhanced with structural creative code libraries.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <% skills.slice(0, 4).forEach((skill) => { %>
              <span class="glass-chip"><%= skill %></span>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Skills Section -->
<section class="py-20">
  <div class="container-page">
    <div class="text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-[#7c3aed] dark:text-[#a78bfa]">Capabilities</p>
      <h2 class="mt-3 font-display text-4xl font-extrabold text-[#1a1a2e] dark:text-white">Skills & Expertise</h2>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% skills.forEach((skill, i) => { %>
        <div class="glass-card animate-fade-up p-6" style="animation-delay: <%= i * 50 %>ms">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
            <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-[#1a1a2e] dark:text-white"><%= skill %></h3>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Experience Section -->
<section class="py-20">
  <div class="container-page">
    <div class="text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-[#7c3aed] dark:text-[#a78bfa]">Experience</p>
      <h2 class="mt-3 font-display text-4xl font-extrabold text-[#1a1a2e] dark:text-white">Architecture-minded execution.</h2>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <% experience.forEach((item, i) => { %>
        <div class="glass-card animate-fade-up p-6" style="animation-delay: <%= i * 100 %>ms">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed] to-[#6366f1] text-lg font-bold text-white shadow-lg shadow-[#7c3aed]/25">
            <%= item.role.charAt(0) %>
          </div>
          <h3 class="text-xl font-extrabold text-[#1a1a2e] dark:text-white"><%= item.role %></h3>
          <p class="mt-3 text-sm leading-6 text-[#64748b] dark:text-[#a0a8bd]"><%= item.detail %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Tech Stack Section -->
<section class="py-20">
  <div class="container-page">
    <div class="glass-panel bg-gradient-to-br from-[#1e293b]/90 to-[#0f172a]/90 p-10 text-center sm:p-14">
      <p class="text-sm font-bold uppercase tracking-widest text-[#a78bfa]">Tech Stack</p>
      <h2 class="mt-3 font-display text-4xl font-extrabold text-white">Modern, durable, and intentionally lightweight.</h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <% techStack.forEach((tech) => { %>
          <span class="animate-fade-up rounded-xl border border-white/10 bg-white/10 px-5 py-3 text-sm font-bold text-white/90 shadow-lg backdrop-blur-md transition-all duration-300 hover:border-[#a78bfa]/40 hover:bg-white/15"><%= tech %></span>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<!-- Featured Projects Section -->
<section class="py-20">
  <div class="container-page">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-[#7c3aed] dark:text-[#a78bfa]">Projects</p>
        <h2 class="mt-3 font-display text-4xl font-extrabold text-[#1a1a2e] dark:text-white">Selected builds and platform areas.</h2>
      </div>
      <a href="/projects" class="btn-secondary">All Projects</a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <% featuredProjects.forEach((project, i) => { %>
        <article class="glass-card animate-fade-up p-6" style="animation-delay: <%= i * 100 %>ms">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
            <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
          </div>
          <h3 class="text-xl font-extrabold"><a href="<%= project.href %>" class="text-[#1a1a2e] transition-colors hover:text-[#7c3aed] dark:text-white dark:hover:text-[#a78bfa]"><%= project.title %></a></h3>
          <p class="mt-3 text-sm leading-6 text-[#64748b] dark:text-[#a0a8bd]"><%= project.summary %></p>
          <div class="mt-5 flex flex-wrap gap-2">
            <% project.stack.slice(0, 4).forEach((tech) => { %>
              <span class="glass-chip !px-2.5 !py-1 text-xs"><%= tech %></span>
            <% }) %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- Featured Tools Section -->
<section class="py-20">
  <div class="container-page">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-[#7c3aed] dark:text-[#a78bfa]">Tools</p>
        <h2 class="mt-3 font-display text-4xl font-extrabold text-[#1a1a2e] dark:text-white">Fast utilities with their own SEO pages.</h2>
      </div>
      <a href="https://tools.kabirmahmud.xyz" target="_blank" rel="noopener noreferrer" class="btn-secondary">All Tools</a>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% featuredTools.forEach((tool, i) => { %>
        <a class="glass-card animate-fade-up p-5" href="<%= tool.route %>" style="animation-delay: <%= i * 50 %>ms">
          <p class="text-xs font-bold uppercase tracking-wider text-[#7c3aed] dark:text-[#a78bfa]"><%= tool.category %></p>
          <h3 class="mt-2 text-lg font-extrabold text-[#1a1a2e] dark:text-white"><%= tool.name %></h3>
          <p class="mt-2 text-sm leading-6 text-[#64748b] dark:text-[#a0a8bd]"><%= tool.description %></p>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Latest Blog Posts Section -->
<section class="py-20">
  <div class="container-page">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-[#7c3aed] dark:text-[#a78bfa]">Blog</p>
        <h2 class="mt-3 font-display text-4xl font-extrabold text-[#1a1a2e] dark:text-white">Technical writing and notes.</h2>
      </div>
      <a href="/blog" class="btn-secondary">Read Blog</a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <% if (!latestPosts.length) { %>
        <article class="glass-card p-6 md:col-span-3">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
            <svg class="h-6 w-6 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
          </div>
          <h3 class="text-xl font-extrabold text-[#1a1a2e] dark:text-white">Publishing system ready</h3>
          <p class="mt-2 text-sm leading-6 text-[#64748b] dark:text-[#a0a8bd]">Latest published posts will appear here automatically.</p>
        </article>
      <% } %>
      <% latestPosts.forEach((post, i) => { %>
        <article class="glass-card animate-fade-up p-6" style="animation-delay: <%= i * 100 %>ms">
          <p class="text-xs font-bold uppercase tracking-wider text-[#7c3aed] dark:text-[#a78bfa]"><%= post.readingTime %> min read</p>
          <h3 class="mt-3 text-xl font-extrabold"><a href="/blog/<%= post.slug %>" class="text-[#1a1a2e] transition-colors hover:text-[#7c3aed] dark:text-white dark:hover:text-[#a78bfa]"><%= post.title %></a></h3>
          <p class="mt-3 text-sm leading-6 text-[#64748b] dark:text-[#a0a8bd]"><%= post.excerpt %></p>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- Testimonials Section -->
<section class="py-20">
  <div class="container-page">
    <div class="text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-[#7c3aed] dark:text-[#a78bfa]">Testimonials</p>
      <h2 class="mt-3 font-display text-4xl font-extrabold text-[#1a1a2e] dark:text-white">What partners say.</h2>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <% testimonials.forEach((item, i) => { %>
        <figure class="glass-card animate-fade-up p-8" style="animation-delay: <%= i * 100 %>ms">
          <svg class="mb-4 h-8 w-8 text-[#7c3aed]/30" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z" /></svg>
          <blockquote class="text-lg font-semibold leading-8 text-[#475569] dark:text-[#c9d1e8]"><%= item.quote %></blockquote>
          <figcaption class="mt-4 flex items-center gap-3">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-[#7c3aed] to-[#6366f1] text-xs font-bold text-white shadow-md shadow-[#7c3aed]/25"><%= item.name.charAt(0) %></div>
            <span class="text-sm font-bold text-[#1a1a2e] dark:text-white"><%= item.name %></span>
          </figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>

<!-- CTA Section -->
