<section class="grid min-h-[calc(100vh-4rem)] place-items-center bg-paper dark:bg-[#0d1117] py-12">
  <div class="w-full max-w-md px-4">
    <div class="rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#161b22] p-6 shadow-sm">
      <h1 class="font-display text-3xl font-extrabold text-[#1a1a2e] dark:text-[#f0f6fc]">Choose new password</h1>
      <p class="mt-3 text-sm leading-6 text-[#64748b] dark:text-[#8b949e]">Use at least 12 characters with uppercase, lowercase, and a number.</p>
      <% if (errors.length) { %>
        <div class="mt-5 rounded-xl border border-[#ef4444]/20 bg-[#ef4444]/10 p-4 text-sm font-medium text-[#ef4444]">
          <% errors.forEach((error) => { %><p><%= error %></p><% }) %>
        </div>
      <% } %>
      <form action="/admin/reset-password/<%= token %>" method="post" class="mt-6 grid gap-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="grid gap-1.5 text-sm font-bold text-[#475569] dark:text-[#8b949e]">Password
          <input class="w-full rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#0d1117] px-4 py-3 text-[#1a1a2e] dark:text-[#f0f6fc] placeholder-[#94a3b8] transition-all focus:border-[#7c3aed]/40 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/10" name="password" type="password" autocomplete="new-password" required minlength="12" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;">
        </label>
        <label class="grid gap-1.5 text-sm font-bold text-[#475569] dark:text-[#8b949e]">Confirm password
          <input class="w-full rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#0d1117] px-4 py-3 text-[#1a1a2e] dark:text-[#f0f6fc] placeholder-[#94a3b8] transition-all focus:border-[#7c3aed]/40 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/10" name="confirmPassword" type="password" autocomplete="new-password" required minlength="12" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;">
        </label>
        <button class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#7c3aed] to-[#6366f1] px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-[#7c3aed]/20 transition-all hover:shadow-xl" type="submit">Update Password</button>
      </form>
    </div>
  </div>
</section>