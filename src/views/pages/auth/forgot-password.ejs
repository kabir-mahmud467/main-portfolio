<section class="grid min-h-[calc(100vh-4rem)] place-items-center py-12">
  <div class="w-full max-w-md px-4">
    <div class="glass-panel p-8">
      <h1 class="font-display text-3xl font-extrabold text-[#1a1a2e] dark:text-[#f0f6fc]">Reset access</h1>
      <p class="mt-3 text-sm leading-6 text-[#64748b] dark:text-[#8b949e]">Enter the admin email address to generate a secure reset link.</p>
      <% if (errors.length) { %>
        <div class="mt-5 rounded-xl border border-[#ef4444]/20 bg-[#ef4444]/10 p-4 text-sm font-medium text-[#ef4444]">
          <% errors.forEach((error) => { %><p><%= error %></p><% }) %>
        </div>
      <% } %>
      <form action="/admin/forgot-password" method="post" class="mt-6 grid gap-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="grid gap-1.5 text-sm font-bold text-[#475569] dark:text-[#8b949e]">Email
          <input class="glass-input" name="email" type="email" autocomplete="email" placeholder="admin@example.com" required>
        </label>
        <button class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#7c3aed] to-[#6366f1] px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-[#7c3aed]/20 transition-all hover:shadow-xl" type="submit">Request Reset</button>
      </form>
      <a class="mt-5 inline-flex text-sm font-bold text-[#7c3aed] dark:text-[#a78bfa] hover:text-[#1a1a2e] dark:hover:text-[#f0f6fc] transition-colors" href="/admin/login">Back to login</a>
    </div>
  </div>
</section>