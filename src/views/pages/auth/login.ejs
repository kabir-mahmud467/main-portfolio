<section class="grid min-h-[calc(100vh-4rem)] place-items-center bg-paper dark:bg-[#0d1117] py-12">
  <div class="w-full max-w-md px-4">
    <div class="rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#161b22] p-6 shadow-sm">
      <p class="text-sm font-bold uppercase tracking-wider text-[#7c3aed] dark:text-[#a78bfa]">Admin</p>
      <h1 class="mt-2 font-display text-3xl font-extrabold text-[#1a1a2e] dark:text-[#f0f6fc]">Sign in</h1>
      <% if (errors.length) { %>
        <div class="mt-5 rounded-xl border border-[#ef4444]/20 bg-[#ef4444]/10 p-4 text-sm font-medium text-[#ef4444]">
          <% errors.forEach((error) => { %><p><%= error %></p><% }) %>
        </div>
      <% } %>
      <form action="/admin/login" method="post" class="mt-6 grid gap-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="next" value="<%= next %>">
        <label class="grid gap-1.5 text-sm font-bold text-[#475569] dark:text-[#8b949e]">Email
          <input class="w-full rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#0d1117] px-4 py-3 text-[#1a1a2e] dark:text-[#f0f6fc] placeholder-[#94a3b8] transition-all focus:border-[#7c3aed]/40 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/10" name="email" type="email" autocomplete="email" placeholder="admin@example.com" required>
        </label>
        <label class="grid gap-1.5 text-sm font-bold text-[#475569] dark:text-[#8b949e]">Password
          <input class="w-full rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#0d1117] px-4 py-3 text-[#1a1a2e] dark:text-[#f0f6fc] placeholder-[#94a3b8] transition-all focus:border-[#7c3aed]/40 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/10" name="password" type="password" autocomplete="current-password" required minlength="8" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;">
        </label>
        <label class="flex cursor-pointer items-center gap-2 text-sm font-medium text-[#64748b] dark:text-[#8b949e]">
          <input class="h-4 w-4 rounded border-[#e2e8f0] text-[#7c3aed] focus:ring-[#7c3aed]/30" name="remember" type="checkbox">
          Remember me
        </label>
        <button class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#7c3aed] to-[#6366f1] px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-[#7c3aed]/20 transition-all hover:shadow-xl" type="submit">Login</button>
      </form>
      <a class="mt-5 inline-flex text-sm font-bold text-[#7c3aed] dark:text-[#a78bfa] hover:text-[#1a1a2e] dark:hover:text-[#f0f6fc] transition-colors" href="/admin/forgot-password">Forgot password?</a>
    </div>
  </div>
</section>