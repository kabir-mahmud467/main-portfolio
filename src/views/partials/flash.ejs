<% if (flash.success && flash.success.length) { %>
  <section class="pt-6">
    <% flash.success.forEach((message) => { %>
      <div class="rounded-xl border border-[#22c55e]/20 bg-[#22c55e]/10 px-5 py-3.5 text-sm font-medium text-[#16a34a] dark:text-[#4ade80]">
        <%= message %>
      </div>
    <% }) %>
  </section>
<% } %>

<% if (flash.error && flash.error.length) { %>
  <section class="pt-6">
    <% flash.error.forEach((message) => { %>
      <div class="rounded-xl border border-[#ef4444]/20 bg-[#ef4444]/10 px-5 py-3.5 text-sm font-medium text-[#ef4444]">
        <%= message %>
      </div>
    <% }) %>
  </section>
<% } %>