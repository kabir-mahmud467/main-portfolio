<header class="glass-nav sticky top-0 z-40">
  <a href="#main-content" class="focus-ring sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2">
    Skip to content
  </a>
  <div class="container-page">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="focus-ring rounded-md font-display text-lg font-extrabold tracking-normal text-ink dark:text-white">
        Kabir Mahmud
      </a>

      <%- include("./navbar") %>

      <button
        type="button"
        data-menu-button
        class="focus-ring inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/70 bg-white/60 text-ink backdrop-blur-md dark:border-white/10 dark:bg-white/10 dark:text-white md:hidden"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="h-0.5 w-5 bg-ink before:block before:h-0.5 before:w-5 before:-translate-y-1.5 before:bg-ink after:block after:h-0.5 after:w-5 after:translate-y-1 after:bg-ink dark:bg-white dark:before:bg-white dark:after:bg-white"></span>
      </button>
    </div>

    <div data-mobile-menu class="hidden border-t border-white/40 py-3 backdrop-blur-xl md:hidden dark:border-white/10">
      <nav class="grid gap-1" aria-label="Mobile navigation">
        <a class="nav-link <%= currentPath === '/' ? 'nav-link-active' : '' %>" href="/">Home</a>
        <a class="nav-link <%= currentPath === '/about' ? 'nav-link-active' : '' %>" href="/about">About</a>
        <a class="nav-link <%= currentPath.startsWith('/blog') ? 'nav-link-active' : '' %>" href="/blog">Blog</a>
        <a class="nav-link <%= currentPath.startsWith('/projects') ? 'nav-link-active' : '' %>" href="/projects">Projects</a>
        <a class="nav-link" href="https://tools.kabirmahmud.xyz" target="_blank" rel="noopener noreferrer">Tools</a>
        <a class="nav-link <%= currentPath === '/contact' ? 'nav-link-active' : '' %>" href="/contact">Contact</a>
      </nav>
    </div>
  </div>
</header>
