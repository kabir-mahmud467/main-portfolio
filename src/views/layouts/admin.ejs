<!doctype html>
<html lang="en" class="dark">
  <head>
    <%- include("../partials/head") %>
    <%- typeof style !== "undefined" ? style : "" %>
  </head>
  <body class="relative min-h-screen overflow-x-hidden bg-[#f3f0e8] font-sans text-[#1a1a2e] dark:bg-[#0b0f19] dark:text-[#f0f6fc]">
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="animate-aurora absolute -top-48 -right-32 h-[34rem] w-[34rem] rounded-full bg-[#7c3aed]/20 blur-3xl dark:bg-[#7c3aed]/12"></div>
      <div class="animate-aurora-delayed absolute top-1/2 -left-48 h-[30rem] w-[30rem] rounded-full bg-[#6366f1]/15 blur-3xl dark:bg-[#6366f1]/10"></div>
      <div class="animate-aurora absolute -bottom-52 right-1/3 h-[28rem] w-[28rem] rounded-full bg-[#ec4899]/10 blur-3xl dark:bg-[#ec4899]/[0.06]"></div>
    </div>

    <div class="min-h-screen lg:flex">
      <%- include("../partials/sidebar") %>

      <div class="min-w-0 flex-1">
        <header class="glass-nav sticky top-0 z-30 border-b border-white/60 dark:border-white/10">
          <div class="flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
            <button
              type="button"
              data-sidebar-button
              class="focus-ring inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/70 bg-white/60 text-[#1a1a2e] backdrop-blur-md dark:border-white/10 dark:bg-white/10 dark:text-[#f0f6fc] lg:hidden"
              aria-label="Toggle admin sidebar"
            >
              <span class="h-0.5 w-5 bg-[#1a1a2e] before:block before:h-0.5 before:w-5 before:-translate-y-1.5 before:bg-[#1a1a2e] after:block after:h-0.5 after:w-5 after:translate-y-1 after:bg-[#1a1a2e] dark:bg-[#f0f6fc] dark:before:bg-[#f0f6fc] dark:after:bg-[#f0f6fc]"></span>
            </button>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-[#64748b] dark:text-[#8b949e]">Admin</p>
              <h1 class="font-display text-xl font-bold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= title %></h1>
            </div>
            <div class="flex items-center gap-2">
              <button data-dark-mode-button type="button" class="focus-ring inline-flex min-h-10 items-center rounded-xl border border-white/70 bg-white/60 px-3 text-sm font-bold text-[#475569] backdrop-blur-md dark:border-white/10 dark:bg-white/10 dark:text-[#8b949e]">Dark</button>
              <a href="/" class="btn-secondary dark:!border-white/10 dark:!bg-white/10 dark:!text-[#8b949e]">View Site</a>
            </div>
          </div>
        </header>

        <main class="px-4 py-8 sm:px-6 lg:px-8">
          <%- include("../partials/flash") %>
          <%- body %>
        </main>
      </div>
    </div>

    <script src="/js/admin.js" defer></script>
    <%- typeof script !== "undefined" ? script : "" %>
  </body>
</html>
