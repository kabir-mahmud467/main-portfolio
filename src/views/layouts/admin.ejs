<!doctype html>
<html lang="en">
  <head>
    <%- include("../partials/head") %>
    <style>
      .dark .btn-secondary { border-color: rgba(255,255,255,0.1); background-color: rgba(255,255,255,0.1); color: #fff; }
      .dark .btn-secondary:hover { border-color: rgba(124,58,237,0.4); background-color: rgba(124,58,237,0.15); }
      .dark .focus-ring:focus-visible { --tw-ring-offset-color: #0d1117; }
    </style>
    <%- typeof style !== "undefined" ? style : "" %>
  </head>
  <body class="min-h-screen bg-[#f3f0e8] dark:bg-[#0d1117] font-sans text-[#1a1a2e] dark:text-[#f0f6fc]">
    <div class="min-h-screen lg:flex">
      <%- include("../partials/sidebar") %>

      <div class="min-w-0 flex-1">
        <header class="sticky top-0 z-30 border-b border-[#e2e8f0] dark:border-[#30363d] bg-white/90 dark:bg-[#161b22]/90 backdrop-blur">
          <div class="flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
            <button
              type="button"
              data-sidebar-button
              class="focus-ring inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#161b22] lg:hidden"
              aria-label="Toggle admin sidebar"
            >
              <span class="h-0.5 w-5 bg-[#1a1a2e] dark:bg-[#f0f6fc] before:block before:h-0.5 before:w-5 before:-translate-y-1.5 before:bg-[#1a1a2e] dark:before:bg-[#f0f6fc] after:block after:h-0.5 after:w-5 after:translate-y-1 after:bg-[#1a1a2e] dark:after:bg-[#f0f6fc]"></span>
            </button>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-[#64748b] dark:text-[#8b949e]">Admin</p>
              <h1 class="font-display text-xl font-bold"><%= title %></h1>
            </div>
            <div class="flex items-center gap-2">
              <button data-dark-mode-button type="button" class="focus-ring inline-flex min-h-10 items-center rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#161b22] px-3 text-sm font-bold text-[#475569] dark:text-[#8b949e]">Dark</button>
              <a href="/" class="btn-secondary dark:!border-[#30363d] dark:!bg-[#161b22] dark:!text-[#8b949e]">View Site</a>
            </div>
          </div>
        </header>

        <main class="px-4 py-8 sm:px-6 lg:px-8">
          <%- include("../partials/flash") %>
          <%- body %>
        </main>
      </div>
    </div>

    <script src="/js/admin.js" defer></script>
    <%- typeof script !== "undefined" ? script : "" %>
  </body>
</html>
