<!doctype html>
<html lang="en" class="dark">
  <head>
    <%- include("../partials/head") %>
    <%- typeof style !== "undefined" ? style : "" %>
  </head>
  <body class="relative min-h-screen overflow-x-hidden bg-[#f6f3fc] font-sans text-[#1a1a2e] dark:bg-[#0b0f19] dark:text-[#f0f6fc]">
    <div class="pointer-events-none fixed inset-0 -z-10 hidden overflow-hidden md:block" aria-hidden="true">
      <div class="animate-aurora absolute -top-48 -right-32 h-[36rem] w-[36rem] rounded-full bg-[#7c3aed]/25 blur-3xl dark:bg-[#7c3aed]/15"></div>
      <div class="animate-aurora-delayed absolute top-1/3 -left-48 h-[32rem] w-[32rem] rounded-full bg-[#6366f1]/20 blur-3xl dark:bg-[#6366f1]/10"></div>
      <div class="animate-aurora absolute -bottom-52 right-1/4 h-[30rem] w-[30rem] rounded-full bg-[#ec4899]/15 blur-3xl dark:bg-[#ec4899]/[0.07]"></div>
      <div class="animate-aurora-delayed absolute top-1/4 right-1/5 h-80 w-80 rounded-full bg-[#22d3ee]/15 blur-3xl dark:bg-[#22d3ee]/[0.07]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.55),transparent_60%)] dark:bg-[radial-gradient(ellipse_at_top,rgba(124,58,237,0.08),transparent_60%)]"></div>
    </div>

    <%- include("../partials/header") %>

    <main id="main-content">
      <%- include("../partials/flash") %>
      <%- body %>
    </main>

    <%- include("../partials/footer") %>
    <script src="/js/main.js" defer></script>
    <%- typeof script !== "undefined" ? script : "" %>
  </body>
</html>
