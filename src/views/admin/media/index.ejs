<section class="glass-card p-6">
  <div class="flex items-center justify-between">
    <div>
      <p class="text-sm font-bold uppercase tracking-wider text-flame">Assets</p>
      <h2 class="mt-2 font-display text-3xl font-extrabold">Media Library</h2>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-ink/70 dark:text-white/65">Upload, manage, and organize images for your content.</p>
    </div>
  </div>

  <form action="/admin/media/upload" method="post" enctype="multipart/form-data" class="mt-6 flex items-end gap-4 glass-card rounded-2xl border-dashed p-5">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="flex-1">
      <label for="file" class="mb-1 block text-sm font-semibold">Upload File</label>
      <input type="file" id="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml,application/pdf"
        class="w-full text-sm file:mr-3 file:rounded-md file:border-0 file:bg-ocean file:px-3 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-ocean/90">
    </div>
    <button type="submit" class="btn-primary whitespace-nowrap">Upload</button>
  </form>

  <% if (media.length) { %>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      <% media.forEach((item) => { %>
        <article class="group relative overflow-hidden glass-card rounded-xl">
          <div class="aspect-video overflow-hidden bg-ink/5 dark:bg-white/10">
            <% if (item.type === 'image') { %>
              <img src="<%= item.thumbnailUrl || item.url %>" alt="<%= item.alt || item.originalName %>" class="h-full w-full object-cover" loading="lazy">
            <% } else { %>
              <div class="flex h-full items-center justify-center text-4xl font-bold text-ink/20">PDF</div>
            <% } %>
          </div>
          <div class="p-3">
            <p class="truncate text-sm font-medium" title="<%= item.originalName %>"><%= item.originalName %></p>
            <p class="text-xs text-ink/60 dark:text-white/60"><%= (item.size / 1024).toFixed(1) %> KB</p>
            <div class="mt-2 flex gap-2">
              <button onclick="document.getElementById('alt-form-<%= item._id %>').classList.toggle('hidden')" class="text-xs text-ocean hover:underline">Edit Alt</button>
              <form action="/admin/media/<%= item._id %>/delete" method="post" class="inline" onsubmit="return confirm('Delete this file?')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="text-xs text-flame hover:underline">Delete</button>
              </form>
            </div>
            <form id="alt-form-<%= item._id %>" action="/admin/media/<%= item._id %>/alt" method="post" class="mt-2 hidden">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="flex gap-2">
                <input type="text" name="alt" value="<%= item.alt %>" placeholder="Alt text" class="glass-input flex-1 !py-1.5 text-xs">
                <button class="rounded bg-ocean px-2 py-1 text-xs text-white">Save</button>
              </div>
            </form>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="mt-8 glass-card rounded-2xl border-dashed p-12 text-center">
      <p class="text-lg font-semibold text-ink/40 dark:text-white/40">No media yet</p>
      <p class="mt-1 text-sm text-ink/30 dark:text-white/30">Upload images to use them in your content.</p>
    </div>
  <% } %>
</section>
