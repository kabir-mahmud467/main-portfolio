<!-- Overview Cards -->
<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <article class="rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-[#64748b]">Published Posts</p>
      <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10 flex items-center justify-center">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
      </div>
    </div>
    <p class="mt-4 font-display text-4xl font-extrabold text-[#1a1a2e]"><%= metrics.totalPosts %></p>
    <p class="mt-1 text-xs text-[#94a3b8]">+<%= metrics.postsLast30 %> in last 30 days</p>
  </article>
  <article class="rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-[#64748b]">Live Projects</p>
      <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10 flex items-center justify-center">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" /></svg>
      </div>
    </div>
    <p class="mt-4 font-display text-4xl font-extrabold text-[#1a1a2e]"><%= metrics.totalProjects %></p>
  </article>
  <article class="rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-[#64748b]">Active Tools</p>
      <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10 flex items-center justify-center">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
      </div>
    </div>
    <p class="mt-4 font-display text-4xl font-extrabold text-[#1a1a2e]"><%= metrics.totalTools %></p>
  </article>
  <article class="rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-[#64748b]">Media Files</p>
      <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10 flex items-center justify-center">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" /></svg>
      </div>
    </div>
    <p class="mt-4 font-display text-4xl font-extrabold text-[#1a1a2e]"><%= metrics.totalMedia %></p>
  </article>
</section>

<!-- Bottom Grid -->
<section class="mt-8 grid gap-6 lg:grid-cols-2">
  <!-- Messages Breakdown -->
  <article class="rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-6">
      <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10 flex items-center justify-center">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
      </div>
      <h2 class="font-display text-2xl font-extrabold text-[#1a1a2e]">Messages</h2>
    </div>
    <div class="grid gap-3">
      <div class="flex items-center justify-between rounded-lg bg-[#faf9f6] px-4 py-3">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#7c3aed]"></span>
          <span class="text-sm font-semibold text-[#475569]">Total</span>
        </div>
        <span class="font-display text-2xl font-bold text-[#1a1a2e]"><%= metrics.totalMessages %></span>
      </div>
      <div class="flex items-center justify-between rounded-lg bg-[#faf9f6] px-4 py-3">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#22c55e]"></span>
          <span class="text-sm font-semibold text-[#475569]">New</span>
        </div>
        <span class="font-display text-2xl font-bold text-[#22c55e]"><%= metrics.newMessages %></span>
      </div>
      <div class="flex items-center justify-between rounded-lg bg-[#faf9f6] px-4 py-3">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#3b82f6]"></span>
          <span class="text-sm font-semibold text-[#475569]">Read</span>
        </div>
        <span class="font-display text-2xl font-bold text-[#3b82f6]"><%= metrics.readMessages %></span>
      </div>
      <div class="flex items-center justify-between rounded-lg bg-[#faf9f6] px-4 py-3">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#94a3b8]"></span>
          <span class="text-sm font-semibold text-[#475569]">Archived</span>
        </div>
        <span class="font-display text-2xl font-bold text-[#94a3b8]"><%= metrics.archivedMessages %></span>
      </div>
    </div>
    <p class="mt-4 text-xs text-[#94a3b8]"><%= metrics.messagesLast30 %> messages in last 30 days</p>
  </article>

  <!-- Top Posts -->
  <article class="rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-6">
      <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10 flex items-center justify-center">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
      </div>
      <h2 class="font-display text-2xl font-extrabold text-[#1a1a2e]">Top Posts</h2>
    </div>
    <% if (topPosts.length) { %>
      <div class="grid gap-2">
        <% topPosts.forEach((post, i) => { %>
          <div class="flex items-center justify-between rounded-lg bg-[#faf9f6] px-4 py-3 transition hover:bg-[#7c3aed]/5">
            <div class="flex items-center gap-3">
              <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-[#7c3aed] to-[#6366f1] text-xs font-bold text-white"><%= i + 1 %></span>
              <div>
                <p class="text-sm font-semibold text-[#1a1a2e]"><%= post.title %></p>
                <p class="text-xs text-[#94a3b8]"><%= new Date(post.publishedAt).toLocaleDateString() %> &middot; <%= post.views %> views</p>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="flex flex-col items-center justify-center py-12 text-center">
        <div class="h-12 w-12 rounded-xl bg-[#7c3aed]/10 flex items-center justify-center mb-4">
          <svg class="h-6 w-6 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
        </div>
        <p class="text-sm font-semibold text-[#64748b]">No posts published yet</p>
      </div>
    <% } %>
  </article>
</section>

<!-- Category Distribution & Growth -->
<section class="mt-8">
  <article class="rounded-xl border border-[#e2e8f0] bg-white p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-6">
      <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10 flex items-center justify-center">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
      </div>
      <h2 class="font-display text-2xl font-extrabold text-[#1a1a2e]">Growth Indicators</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-[#e2e8f0] bg-gradient-to-br from-[#7c3aed]/5 to-[#6366f1]/5 p-5">
        <p class="text-sm font-bold text-[#7c3aed]">Content</p>
        <p class="mt-2 font-display text-3xl font-bold text-[#1a1a2e]"><%= metrics.totalPosts %></p>
        <div class="mt-3 flex items-center gap-2 text-xs text-[#22c55e]">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
          <span><%= metrics.postsLast30 %> new (30d)</span>
        </div>
      </div>
      <div class="rounded-xl border border-[#e2e8f0] bg-gradient-to-br from-[#7c3aed]/5 to-[#6366f1]/5 p-5">
        <p class="text-sm font-bold text-[#7c3aed]">Engagement</p>
        <p class="mt-2 font-display text-3xl font-bold text-[#1a1a2e]"><%= metrics.totalMessages %></p>
        <div class="mt-3 flex items-center gap-2 text-xs text-[#3b82f6]">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75L12 3m0 0l3.75 3.75M12 3v18" /></svg>
          <span><%= metrics.messagesLast30 %> new (30d)</span>
        </div>
      </div>
      <div class="rounded-xl border border-[#e2e8f0] bg-gradient-to-br from-[#7c3aed]/5 to-[#6366f1]/5 p-5">
        <p class="text-sm font-bold text-[#7c3aed]">Media</p>
        <p class="mt-2 font-display text-3xl font-bold text-[#1a1a2e]"><%= metrics.totalMedia %></p>
        <p class="mt-3 text-xs text-[#94a3b8]">uploaded files</p>
      </div>
    </div>
  </article>
</section>
