<!-- Main Metrics Grid -->
<section class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
  <article class="group glass-card p-6 shadow-sm transition-all hover:shadow-md hover:border-[#7c3aed]/20 dark:hover:border-[#7c3aed]/40">
    <div class="flex items-center justify-between">
      <p class="text-sm font-bold text-[#64748b] dark:text-[#8b949e]">Published Posts</p>
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
      </div>
    </div>
    <p class="mt-4 font-display text-4xl font-extrabold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= metrics.totalPosts %></p>
    <div class="mt-2 flex items-center gap-1.5 text-xs">
      <span class="inline-flex items-center gap-1 rounded-full bg-[#22c55e]/10 px-2 py-0.5 font-bold text-[#16a34a] dark:text-[#4ade80]">
        <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
        <%= metrics.postsLast30 %>
      </span>
      <span class="text-[#94a3b8] dark:text-[#6e7681]">in last 30 days</span>
    </div>
  </article>

  <article class="group glass-card p-6 shadow-sm transition-all hover:shadow-md hover:border-[#7c3aed]/20 dark:hover:border-[#7c3aed]/40">
    <div class="flex items-center justify-between">
      <p class="text-sm font-bold text-[#64748b] dark:text-[#8b949e]">Live Projects</p>
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" /></svg>
      </div>
    </div>
    <p class="mt-4 font-display text-4xl font-extrabold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= metrics.totalProjects %></p>
    <p class="mt-2 text-xs text-[#94a3b8] dark:text-[#6e7681]">published and live</p>
  </article>

  <article class="group glass-card p-6 shadow-sm transition-all hover:shadow-md hover:border-[#7c3aed]/20 dark:hover:border-[#7c3aed]/40">
    <div class="flex items-center justify-between">
      <p class="text-sm font-bold text-[#64748b] dark:text-[#8b949e]">Total Views</p>
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      </div>
    </div>
    <p class="mt-4 font-display text-4xl font-extrabold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= metrics.totalViews.toLocaleString() %></p>
    <p class="mt-2 text-xs text-[#94a3b8] dark:text-[#6e7681]">across all posts</p>
  </article>

  <article class="group glass-card p-6 shadow-sm transition-all hover:shadow-md hover:border-[#7c3aed]/20 dark:hover:border-[#7c3aed]/40">
    <div class="flex items-center justify-between">
      <p class="text-sm font-bold text-[#64748b] dark:text-[#8b949e]">Messages</p>
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
      </div>
    </div>
    <p class="mt-4 font-display text-4xl font-extrabold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= metrics.totalMessages %></p>
    <div class="mt-2 flex items-center gap-1.5 text-xs">
      <span class="inline-flex items-center gap-1 rounded-full bg-[#3b82f6]/10 px-2 py-0.5 font-bold text-[#2563eb] dark:text-[#60a5fa]">
        <%= metrics.messagesLast30 %>
      </span>
      <span class="text-[#94a3b8] dark:text-[#6e7681]">in last 30 days</span>
    </div>
  </article>
</section>

<!-- Charts & Breakdowns -->
<section class="mt-8 grid gap-6 lg:grid-cols-2">
  <!-- Messages Breakdown -->
  <article class="glass-card p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-6">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
      </div>
      <h2 class="font-display text-xl font-bold text-[#1a1a2e] dark:text-[#f0f6fc]">Messages Breakdown</h2>
    </div>
    <% var maxMessageCount = Math.max(metrics.newMessages, metrics.readMessages, metrics.archivedMessages, 1); %>
    <div class="grid gap-4">
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-[#22c55e]"></span>
            <span class="text-sm font-bold text-[#475569] dark:text-[#8b949e]">New</span>
          </div>
          <span class="font-display text-xl font-bold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= metrics.newMessages %></span>
        </div>
        <div class="h-2.5 w-full overflow-hidden rounded-full bg-[#e2e8f0] dark:bg-[#30363d]">
          <div class="h-full rounded-full bg-gradient-to-r from-[#22c55e] to-[#4ade80] transition-all duration-500" style="width: <%= (metrics.newMessages / maxMessageCount * 100) %>%"></div>
        </div>
      </div>
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-[#3b82f6]"></span>
            <span class="text-sm font-bold text-[#475569] dark:text-[#8b949e]">Read</span>
          </div>
          <span class="font-display text-xl font-bold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= metrics.readMessages %></span>
        </div>
        <div class="h-2.5 w-full overflow-hidden rounded-full bg-[#e2e8f0] dark:bg-[#30363d]">
          <div class="h-full rounded-full bg-gradient-to-r from-[#3b82f6] to-[#60a5fa] transition-all duration-500" style="width: <%= (metrics.readMessages / maxMessageCount * 100) %>%"></div>
        </div>
      </div>
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-[#94a3b8]"></span>
            <span class="text-sm font-bold text-[#475569] dark:text-[#8b949e]">Archived</span>
          </div>
          <span class="font-display text-xl font-bold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= metrics.archivedMessages %></span>
        </div>
        <div class="h-2.5 w-full overflow-hidden rounded-full bg-[#e2e8f0] dark:bg-[#30363d]">
          <div class="h-full rounded-full bg-gradient-to-r from-[#94a3b8] to-[#cbd5e1] transition-all duration-500" style="width: <%= (metrics.archivedMessages / maxMessageCount * 100) %>%"></div>
        </div>
      </div>
    </div>
    <p class="mt-4 text-xs text-[#94a3b8] dark:text-[#6e7681]"><%= metrics.messagesLast30 %> messages received in the last 30 days</p>
  </article>

  <!-- Top Posts -->
  <article class="glass-card p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-6">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
      </div>
      <h2 class="font-display text-xl font-bold text-[#1a1a2e] dark:text-[#f0f6fc]">Top Posts</h2>
    </div>
    <% if (topPosts.length) { %>
      <div class="grid gap-3">
        <% var maxViews = Math.max(...topPosts.map(function(p) { return p.views; }), 1); %>
        <% topPosts.forEach(function(post, i) { %>
          <div class="group rounded-xl bg-white/60 dark:bg-white/[0.07] px-4 py-3.5 transition-all hover:bg-[#7c3aed]/5 dark:hover:bg-[#7c3aed]/[0.08]">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3 min-w-0 flex-1">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-[#7c3aed] to-[#6366f1] text-xs font-bold text-white"><%= i + 1 %></span>
                <div class="min-w-0">
                  <p class="truncate text-sm font-bold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= post.title %></p>
                  <p class="text-xs text-[#94a3b8] dark:text-[#6e7681]"><%= new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                </div>
              </div>
              <div class="shrink-0 text-right">
                <p class="text-sm font-bold text-[#7c3aed] dark:text-[#a78bfa]"><%= post.views %></p>
                <p class="text-xs text-[#94a3b8] dark:text-[#6e7681]">views</p>
              </div>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-[#e2e8f0] dark:bg-[#30363d]">
              <div class="h-full rounded-full bg-gradient-to-r from-[#7c3aed]/60 to-[#7c3aed] transition-all duration-500" style="width: <%= (post.views / maxViews * 100) %>%"></div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="flex flex-col items-center justify-center py-12 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#7c3aed]/10">
          <svg class="h-6 w-6 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
        </div>
        <p class="mt-3 text-sm font-bold text-[#64748b] dark:text-[#8b949e]">No published posts yet</p>
        <p class="text-xs text-[#94a3b8] dark:text-[#6e7681]">Views will appear here once posts are published.</p>
      </div>
    <% } %>
  </article>
</section>

<!-- Growth Indicators -->
<section class="mt-8">
  <article class="glass-card p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-6">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
      </div>
      <h2 class="font-display text-xl font-bold text-[#1a1a2e] dark:text-[#f0f6fc]">Growth Indicators</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-gradient-to-br from-[#7c3aed]/5 to-[#6366f1]/5 dark:from-[#7c3aed]/10 dark:to-[#6366f1]/10 p-5 transition-all hover:shadow-sm">
        <div class="flex items-center gap-2 mb-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
            <svg class="h-4 w-4 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
          </div>
          <p class="text-sm font-bold text-[#7c3aed] dark:text-[#a78bfa]">Content</p>
        </div>
        <p class="font-display text-3xl font-bold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= metrics.totalPosts %></p>
        <div class="mt-2 flex items-center gap-1.5 text-xs font-bold text-[#22c55e] dark:text-[#4ade80]">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
          <span><%= metrics.postsLast30 %> new (30d)</span>
        </div>
      </div>
      <div class="rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-gradient-to-br from-[#7c3aed]/5 to-[#6366f1]/5 dark:from-[#7c3aed]/10 dark:to-[#6366f1]/10 p-5 transition-all hover:shadow-sm">
        <div class="flex items-center gap-2 mb-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
            <svg class="h-4 w-4 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369v5.41l3.67-3.116c.578-.491 1.31-.753 2.065-.753h1.265c1.742 0 3.15-1.372 3.15-3.066V8.25c0-1.694-1.408-3.066-3.15-3.066H7.875c-1.742 0-3.15 1.372-3.15 3.066v3.534z" /></svg>
          </div>
          <p class="text-sm font-bold text-[#7c3aed] dark:text-[#a78bfa]">Engagement</p>
        </div>
        <p class="font-display text-3xl font-bold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= metrics.totalMessages %></p>
        <div class="mt-2 flex items-center gap-1.5 text-xs font-bold text-[#3b82f6] dark:text-[#60a5fa]">
          <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
          <span><%= metrics.messagesLast30 %> new (30d)</span>
        </div>
      </div>
      <div class="rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-gradient-to-br from-[#7c3aed]/5 to-[#6366f1]/5 dark:from-[#7c3aed]/10 dark:to-[#6366f1]/10 p-5 transition-all hover:shadow-sm">
        <div class="flex items-center gap-2 mb-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10">
            <svg class="h-4 w-4 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
          </div>
          <p class="text-sm font-bold text-[#7c3aed] dark:text-[#a78bfa]">Projects</p>
        </div>
        <p class="font-display text-3xl font-bold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= metrics.totalProjects %></p>
        <p class="mt-2 text-xs text-[#94a3b8] dark:text-[#6e7681]">live projects</p>
      </div>
    </div>
  </article>
</section>