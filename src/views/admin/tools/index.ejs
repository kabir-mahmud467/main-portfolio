<section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <p class="text-sm font-bold uppercase tracking-wider text-flame">Tools</p>
    <h2 class="font-display text-3xl font-extrabold">Manage tools</h2>
  </div>
  <a class="btn-primary" href="/admin/tools/new">Create Tool</a>
</section>

<section class="mt-6 grid gap-4">
  <% tools.forEach((tool) => { %>
    <article class="rounded-lg border border-line bg-white p-5 shadow-sm">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h3 class="text-xl font-extrabold"><%= tool.name %></h3>
          <p class="mt-1 text-sm text-ink/60">/<%= tool.slug %> · <%= tool.category %> · <%= tool.status %></p>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-ink/70"><%= tool.description %></p>
        </div>
        <div class="flex gap-2">
          <a class="btn-secondary" href="/admin/tools/<%= tool._id %>/edit">Edit</a>
          <form action="/admin/tools/<%= tool._id %>/delete" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="rounded-md border border-flame/30 px-4 py-3 text-sm font-bold text-flame" type="submit">Delete</button>
          </form>
        </div>
      </div>
    </article>
  <% }) %>
</section>
