<section class="glass-card p-6 shadow-sm">
  <p class="text-sm font-bold uppercase tracking-wider text-[#7c3aed] dark:text-[#a78bfa]"><%= title %></p>
  <h2 class="mt-2 font-display text-3xl font-extrabold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= title %></h2>
  <p class="mt-3 max-w-2xl text-sm leading-6 text-[#64748b] dark:text-[#8b949e]"><%= description %></p>
  <div class="mt-8 grid gap-4 md:grid-cols-3">
    <div class="glass-card p-5">
      <p class="text-sm font-bold text-[#1a1a2e] dark:text-[#f0f6fc]">Status</p>
      <p class="mt-2 text-sm text-[#64748b] dark:text-[#8b949e]">Module shell is ready for CRUD expansion.</p>
    </div>
    <div class="glass-card p-5">
      <p class="text-sm font-bold text-[#1a1a2e] dark:text-[#f0f6fc]">Security</p>
      <p class="mt-2 text-sm text-[#64748b] dark:text-[#8b949e]">Protected by session authentication, role checks, and CSRF.</p>
    </div>
    <div class="glass-card p-5">
      <p class="text-sm font-bold text-[#1a1a2e] dark:text-[#f0f6fc]">Scalable</p>
      <p class="mt-2 text-sm text-[#64748b] dark:text-[#8b949e]">Designed to grow inside the existing MVC module pattern.</p>
    </div>
  </div>
</section>