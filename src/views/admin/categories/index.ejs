<section class="grid gap-6 lg:grid-cols-[24rem_1fr]">
  <form action="/admin/categories" method="post" class="grid content-start gap-4 rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#161b22] p-5 shadow-sm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2 class="font-display text-2xl font-extrabold text-[#1a1a2e] dark:text-[#f0f6fc]">New Category</h2>
    <input class="w-full rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#0d1117] px-4 py-3 text-[#1a1a2e] dark:text-[#f0f6fc] placeholder-[#94a3b8] dark:placeholder-[#6e7681] transition-all focus:border-[#7c3aed]/40 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/10" name="name" placeholder="Name" required>
    <input class="w-full rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#0d1117] px-4 py-3 text-[#1a1a2e] dark:text-[#f0f6fc] placeholder-[#94a3b8] dark:placeholder-[#6e7681] transition-all focus:border-[#7c3aed]/40 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/10 font-mono text-sm" name="slug" placeholder="Slug">
    <textarea class="w-full rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#0d1117] px-4 py-3 text-[#1a1a2e] dark:text-[#f0f6fc] placeholder-[#94a3b8] dark:placeholder-[#6e7681] transition-all focus:border-[#7c3aed]/40 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/10" name="description" rows="4" placeholder="Description"></textarea>
    <button class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-[#7c3aed] to-[#6366f1] px-5 py-3 text-sm font-bold text-white shadow-lg shadow-[#7c3aed]/20 transition-all hover:shadow-xl" type="submit">Create Category</button>
  </form>
  <div class="rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-white dark:bg-[#161b22] p-5 shadow-sm">
    <h2 class="font-display text-2xl font-extrabold text-[#1a1a2e] dark:text-[#f0f6fc]">Categories</h2>
    <div class="mt-5 grid gap-3">
      <% if (!categories.length) { %>
        <p class="text-sm text-[#94a3b8] dark:text-[#6e7681] py-8 text-center">No categories yet.</p>
      <% } %>
      <% categories.forEach((category) => { %>
        <div class="flex items-center justify-between gap-4 rounded-xl border border-[#e2e8f0] dark:border-[#30363d] bg-[#faf9f6] dark:bg-[#0d1117] p-4">
          <div>
            <p class="font-bold text-[#1a1a2e] dark:text-[#f0f6fc]"><%= category.name %></p>
            <p class="text-sm text-[#64748b] dark:text-[#8b949e] font-mono">/<%= category.slug %></p>
          </div>
          <form action="/admin/categories/<%= category._id %>/delete" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="text-sm font-bold text-[#ef4444] hover:text-[#dc2626] transition-colors" type="submit">Delete</button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>
</section>