<section class="rounded-lg border border-line bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5">
  <p class="text-sm font-bold uppercase tracking-wider text-flame">Configuration</p>
  <h2 class="mt-2 font-display text-3xl font-extrabold">Settings</h2>
  <p class="mt-3 max-w-2xl text-sm leading-6 text-ink/70 dark:text-white/65">Configure site metadata, social profiles, email credentials, and platform behavior.</p>

  <div class="mt-8 grid gap-8">
    <% sections.forEach((group) => { %>
      <form action="/admin/settings/<%= group %>" method="post" class="rounded-lg border border-line bg-paper p-5 dark:border-white/10 dark:bg-white/5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h3 class="font-display text-xl font-bold capitalize mb-4"><%= group == 'social' ? 'Social Profiles' : group %> Settings</h3>
        <div class="grid gap-4 md:grid-cols-2">
          <% Object.keys(settings[group]).forEach((key) => { %>
            <div>
              <label for="<%= key %>" class="mb-1 block text-sm font-semibold capitalize"><%= key.replace(/([A-Z])/g, ' $1') %></label>
              <input type="text" id="<%= key %>" name="<%= key %>" value="<%= settings[group][key] %>"
                class="w-full rounded-md border border-line bg-white px-3 py-2 text-sm focus:border-ocean focus:outline-none focus:ring-1 focus:ring-ocean dark:border-white/10 dark:bg-white/5 dark:text-white">
            </div>
          <% }) %>
        </div>
        <button type="submit" class="btn-primary mt-4 inline-block">Save <%= group %> Settings</button>
      </form>
    <% }) %>
  </div>
</section>
