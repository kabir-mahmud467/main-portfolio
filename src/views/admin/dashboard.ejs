<!-- Stats Grid -->
<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <% stats.forEach((item) => { %>
    <article class="glass-card p-6 transition hover:shadow-md">
      <div class="flex items-center justify-between">
        <p class="text-sm font-semibold text-[#64748b]"><%= item.label %></p>
        <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10 flex items-center justify-center">
          <% if (item.icon === 'posts') { %>
            <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
          <% } else if (item.icon === 'views') { %>
            <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          <% } else if (item.icon === 'projects') { %>
            <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" /></svg>
          <% } else if (item.icon === 'tools') { %>
            <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
          <% } else if (item.icon === 'messages') { %>
            <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          <% } else if (item.icon === 'media') { %>
            <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" /></svg>
          <% } else { %>
            <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          <% } %>
        </div>
      </div>
      <p class="mt-4 font-display text-4xl font-extrabold text-[#1a1a2e]"><%= item.value %></p>
      <% if (item.change) { %>
        <p class="mt-1 text-xs text-[#22c55e]">+<%= item.change %> this month</p>
      <% } %>
      <% if (item.total) { %>
        <p class="mt-1 text-xs text-[#94a3b8]"><%= item.total %> total</p>
      <% } %>
    </article>
  <% }) %>
</section>

<!-- Platform Status & Recent Activity -->
<section class="mt-8 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
  <article class="glass-card p-6">
    <div class="flex items-center gap-3 mb-6">
      <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10 flex items-center justify-center">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
      </div>
      <h2 class="font-display text-2xl font-extrabold text-[#1a1a2e]">Quick Actions</h2>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <a class="glass-card px-5 py-4 text-sm font-semibold text-[#1a1a2e] dark:text-[#f0f6fc]" href="/admin/posts">
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          New Post
        </span>
      </a>
      <a class="glass-card px-5 py-4 text-sm font-semibold text-[#1a1a2e] dark:text-[#f0f6fc]" href="/admin/projects/new">
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          New Project
        </span>
      </a>
    </div>
  </article>

  <article class="glass-card p-6">
    <div class="flex items-center gap-3 mb-4">
      <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-[#7c3aed]/10 to-[#6366f1]/10 flex items-center justify-center">
        <svg class="h-5 w-5 text-[#7c3aed]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </div>
      <h2 class="font-display text-xl font-extrabold text-[#1a1a2e]">Recent Posts</h2>
    </div>
    <% if (recentPosts.length) { %>
      <div class="grid gap-2">
        <% recentPosts.forEach((post) => { %>
          <a href="/admin/posts/<%= post._id %>/edit" class="flex items-center justify-between rounded-xl bg-white/60 px-4 py-3 backdrop-blur-md transition hover:bg-[#7c3aed]/10 dark:bg-white/[0.07]">
            <div>
              <p class="text-sm font-semibold text-[#1a1a2e]"><%= post.title %></p>
              <p class="text-xs text-[#94a3b8]"><%= post.views %> views</p>
            </div>
            <svg class="h-4 w-4 text-[#94a3b8]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-sm text-[#94a3b8] py-4">No posts yet. Create your first post!</p>
    <% } %>
  </article>
</section>
